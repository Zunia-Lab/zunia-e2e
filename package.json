{
  "name": "@zunialab/e2e",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "Zunia end-to-end test harness (Playwright + Maestro configs)",
  "scripts": {
    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui",
    "test:dashboard": "playwright test --project=chromium",
    "test:stack": "playwright test -c playwright.stack.config.ts",
    "test:mobile:connect": "node scripts/mobile-connect.mjs",
    "test:signing": "tsx signing/selftest.ts && tsx signing/anchor.ts && tsx signing/tier0-kernel.ts && tsx signing/own-flows.ts",
    "test:signing:extension": "tsx signing/tier1-extension.ts",
    "test:signing:dashboard": "tsx signing/tier2-dashboard.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p signing/tsconfig.json --noEmit",
    "typecheck:stack": "tsc -p tsconfig.stack.json --noEmit"
  },
  "devDependencies": {
    "@cosmjs/amino": "0.33.1",
    "@cosmjs/crypto": "0.33.1",
    "@cosmjs/encoding": "0.33.1",
    "@cosmjs/proto-signing": "0.33.1",
    "@cosmjs/stargate": "0.32.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22",
    "cosmjs-types": "0.9.0",
    "esbuild": "0.28.2",
    "osmojs": "16.15.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  },
  "license": "Apache-2.0"
}
